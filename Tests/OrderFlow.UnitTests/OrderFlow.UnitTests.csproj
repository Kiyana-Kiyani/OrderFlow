    <IsPackable>false</IsPackable>
	  <PreserveCompilationContext>true</PreserveCompilationContext>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Features\Admin\**" />
    <Compile Remove="Features\Auth\**" />
    <Compile Remove="Features\MenuItems\**" />
